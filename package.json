{
  "name": "hebrew-il-mcp",
  "version": "0.1.0",
  "description": "MCP server with Israeli and Hebrew utilities for AI agents: ID/company number validation, phone normalization, VAT, Hebrew dates, numerals and niqqud.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hebrew",
    "israel",
    "ai-agents",
    "vat"
  ],
  "author": "Nadav Shtibel",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "hebrew-il-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shtibel1/hebrew-il-mcp"
  }
}
